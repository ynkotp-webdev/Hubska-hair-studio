---
// ЕСКІЗ B «Полотна»: палітра зі справжніх робіт. Вісім смуг волосся від платини до чорного на всю ширину.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import b1 from '../../assets/eskiz/b1-platyna.jpg';
import b2 from '../../assets/eskiz/b2-blond.jpg';
import b3 from '../../assets/eskiz/b3-rozhevyi.jpg';
import b4 from '../../assets/eskiz/b4-med.jpg';
import b5 from '../../assets/eskiz/b5-mid.jpg';
import b6 from '../../assets/eskiz/b6-bordo.jpg';
import b7 from '../../assets/eskiz/b7-shokolad.jpg';
import b8 from '../../assets/eskiz/b8-chornyi.jpg';

const works = [
  { img: b1, date: '13.10', alt: 'Платиновий блонд' },
  { img: b2, date: '18.11', alt: 'Бежевий блонд' },
  { img: b3, date: '12.11', alt: 'Рожевий блонд, хвилі' },
  { img: b4, date: '24.10', alt: 'Медовий блонд' },
  { img: b5, date: '01.11', alt: 'Мідний' },
  { img: b6, date: '28.10', alt: 'Бордо' },
  { img: b7, date: '17.09', alt: 'Шоколадний' },
  { img: b8, date: '22.10', alt: 'Чорний' },
];
---
<Base title="Ескіз B · Полотна · Hubska Hair Studio" splash>
  <div class="b">
    <Header />
    <section class="b-top">
      <h1>Фарбування волосся у&nbsp;Львові</h1>
      <div class="b-side">
        <p>Вісім робіт студії за вересень–листопад 2026. AirTouch, блонд, складні техніки, виправлення невдалих фарбувань.</p>
        <a class="btn" href="https://ig.me/m/hubska.hair.lviv">Написати в Direct</a>
        <address>вул. Замарстинівська, 36 · пн–пт 10:00–19:00, сб 10:00–17:00</address>
      </div>
    </section>
    <ul class="b-band" id="roboty">
      {works.map((w, i) => (
        <li>
          <Image src={w.img} alt={`${w.alt}: робота Hubska Hair Studio, ${w.date}.2026`} widths={[120, 240, 365]} sizes="12.5vw" loading={i < 8 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
          <span>{w.date}</span>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .b { position: relative; --px: clamp(20px, 3.9vw, 56px); }
  .b-top { display: grid; grid-template-columns: 1fr minmax(260px, 340px); align-items: end; gap: 56px; padding: 132px var(--px) 44px; }
  .b-top h1 { font-size: var(--text-d1); line-height: 0.92; max-width: 8em; }
  .b-side { display: grid; gap: 18px; justify-items: start; padding-bottom: 6px; }
  .b-side p { font-size: var(--text-t2); }
  .b-band { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(8, 1fr); gap: 3px; height: 74svh; min-height: 460px; }
  .b { padding-bottom: 40px; }
  .b-band li { position: relative; min-width: 0; }
  .b-band :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .b-band span { position: absolute; left: 0; bottom: 0; padding: 3px 10px 4px 12px; background: var(--color-ink); font-size: var(--text-t4); color: var(--color-sand); }
  .b-side address { font-style: normal; font-size: var(--text-t4); color: var(--color-sand); }

  @media (max-width: 760px) {
    .b-top { grid-template-columns: 1fr; gap: 16px; padding: 88px var(--px) 24px; }
    .b-top h1 { max-width: none; }
    .b-side { gap: 14px; justify-items: stretch; }
    .b-side p { font-size: var(--text-t3); }
    .b-band { gap: 2px; height: 58svh; min-height: 380px; }
    .b-band span { writing-mode: vertical-rl; rotate: 180deg; left: auto; right: 0; padding: 8px 2px; }
  }
</style>
