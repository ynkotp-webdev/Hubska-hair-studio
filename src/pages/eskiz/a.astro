---
// ЕСКІЗ A «Довжина»: волосся як лінійка ціни. Кадр іде з-під шапки вниз крізь перший екран у прайс.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import hair from '../../assets/eskiz/a-blond.jpg';

// Положення позначок умовне (плечі, лопатки, середина спини, талія): звірити зі шкалою салону.
const scale = [
  { n: 1, at: 0.55 },
  { n: 2, at: 0.67 },
  { n: 3, at: 0.8 },
  { n: 4, at: 0.93 },
];
const rows = [
  ['Фарбування кореня', '1 500–2 000 ₴'],
  ['Тонування', '1 900–3 500 ₴'],
  ['Контуринг', '4 000–5 000 ₴'],
  ['Бразильський блонд', '5 000–6 500 ₴'],
  ['AirTouch класичний', '7 000–8 500 ₴'],
];
---
<Base title="Ескіз A · Довжина · Hubska Hair Studio" splash>
  <div class="a">
    <Header />
    <div class="a-photo">
      <Image src={hair} alt="Блонд після корекції AirTouch, вид зі спини, полиці залу Hubska Hair Studio" widths={[360, 540, 875]} sizes="(max-width: 760px) 80vw, 30vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="a-rail rail" aria-hidden="true"></div>
    <ol class="a-scale" aria-label="Шкала довжин волосся з прайсу">
      {scale.map((s) => <li style={`--at:${s.at}`}><b>{s.n}</b><span>довжина</span></li>)}
    </ol>

    <section class="a-hero">
      <h1>Складне фарбування волосся у&nbsp;Львові</h1>
      <p class="a-lead">AirTouch, блонд, рельєфне фарбування, вихід із чорного. Працюємо вдвох, щоб ви менше часу провели в кріслі.</p>
      <div class="a-act">
        <a class="btn" href="https://ig.me/m/hubska.hair.lviv">Написати в Direct</a>
        <address>вул. Замарстинівська, 36<br />пн–пт 10:00–19:00, сб 10:00–17:00</address>
      </div>
    </section>

    <section class="a-price" id="tsiny">
      <h2>Ціна залежить від довжини</h2>
      <p class="a-note">Орієнтовна вартість для довжини 1–3 стандартної густини волосся. Остаточна залежить від густоти та витрати матеріалу.</p>
      <dl>
        {rows.map(([name, price]) => <div><dt>{name}</dt><dd>{price}</dd></div>)}
      </dl>
      <a class="lnk" href="/tsiny/">Усі ціни</a>
    </section>
  </div>
</Base>

<style>
  .a { position: relative; overflow: clip; --px: clamp(20px, 3.9vw, 56px); --pl: 52%; --pw: min(30vw, 440px); --ph: calc(var(--pw) * 2160 / 875); --gap: 15px; min-height: var(--ph); }
  .a-photo { position: absolute; top: 0; left: var(--pl); width: var(--pw); height: var(--ph); }
  .a-photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .a-rail { position: absolute; top: 0; left: calc(var(--pl) - 13px - var(--gap)); height: var(--ph); }
  .a-scale { position: absolute; top: 0; left: calc(var(--pl) + var(--pw)); height: var(--ph); margin: 0; padding: 0; list-style: none; }
  .a-scale li { position: absolute; top: calc(var(--at) * 100%); left: 0; translate: 0 -50%; display: flex; align-items: baseline; gap: 10px; white-space: nowrap; font-size: var(--text-t4); color: var(--color-sand); }
  .a-scale li::before { content: ""; align-self: center; width: 40px; height: 1px; background: var(--color-brass); }
  .a-scale b { font-family: var(--font-display); font-weight: 400; font-size: var(--text-d4); color: var(--color-gold); }

  .a :global(.hd-nav) { margin-left: 0; }
  .a :global(.hd-tel) { margin-left: auto; }
  .a-hero, .a-price { box-sizing: border-box; width: calc(var(--pl) - 13px - var(--gap)); padding-inline: var(--px) 40px; }
  .a-hero { min-height: 100svh; padding-block: 120px 48px; display: flex; flex-direction: column; justify-content: flex-end; gap: 28px; }
  .a-hero h1 { font-size: var(--text-d1); line-height: 0.92; max-width: 5.2em; }
  .a-lead { font-size: var(--text-t1); line-height: 1.5; max-width: 27em; }
  .a-act { display: flex; align-items: center; gap: 28px; }
  .a-act address { font-style: normal; font-size: var(--text-t3); line-height: 1.5; color: var(--color-sand); }

  .a-price { padding-block: 64px 96px; }
  .a-price h2 { font-size: var(--text-d2); line-height: 1; }
  .a-note { margin-top: 16px; max-width: 34em; font-size: var(--text-t3); color: var(--color-sand); }
  .a-price dl { margin: 36px 0 28px; display: grid; gap: 14px; max-width: 560px; }
  .a-price dl div { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; }
  .a-price dt { font-family: var(--font-display); font-size: var(--text-d4); line-height: 1.15; }
  .a-price dd { margin: 0; white-space: nowrap; color: var(--color-sand); }

  @media (max-width: 760px) {
    .a { --pl: 62vw; --pw: 38vw; --ph: 140svh; --gap: 0px; }
    .a-photo, .a-rail, .a-scale { top: 64px; }
    .a-scale { left: var(--pl); }
    .a-scale li { gap: 0; }
    .a-scale li::before, .a-scale span { display: none; }
    .a-scale b { background: var(--color-ink); padding: 0 9px 2px 7px; }
    .a-hero, .a-price { padding-inline: 20px 8px; }
    .a-hero { min-height: 0; padding-block: 92px 0; justify-content: flex-start; gap: 18px; }
    .a-lead { font-size: var(--text-t3); }
    .a-act { flex-direction: column; align-items: stretch; gap: 14px; }
    .a-act .btn { padding-inline: 10px; }
    .a-price { padding-block: 40px 56px; }
    .a-price dl { gap: 12px; margin-block: 24px; }
    .a-price dl div { flex-direction: column; gap: 0; }
    .a-price dt { font-size: var(--text-t1); font-family: var(--font-text); }
  }
</style>
