---
// ЕСКІЗ C, версія 2 «Дзеркало»: дзеркало залу стоїть посеред фрази «Колористи | у Львові».
// Форма дзеркала як у залі (капсула з LED-контуром), у ньому волосся в русі.
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import p1 from '../../assets/eskiz/c-1.jpg';
import p2 from '../../assets/eskiz/c-2.jpg';
import p3 from '../../assets/eskiz/c-3.jpg';
import p4 from '../../assets/eskiz/c-4.jpg';
// Чотири відео на вибір: ?v=1…4. Після вибору лишається одне.
const posters = (await Promise.all([p1, p2, p3, p4].map((src) => getImage({ src, width: 720, format: 'webp' })))).map((p) => p.src);
---
<Base title="Ескіз C · Дзеркало · Hubska Hair Studio" splash>
  <div class="c">
    <Header />
    <div class="c-rail rail" aria-hidden="true"></div>
    <section class="c-hero">
      <h1><span>Колористи</span> <span>у&nbsp;Львові</span></h1>
      <div class="c-mirror">
        <video class="c-video" muted loop playsinline preload="none" poster={posters[0]} data-posters={JSON.stringify(posters)} aria-label="Волосся після фарбування в русі, робота Hubska Hair Studio">
          <source src="/eskiz/c-1.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="c-act">
        <p>AirTouch, блонд, складні техніки, виправлення невдалих фарбувань. Працюємо вдвох, щоб ви менше часу провели в кріслі.</p>
        <a class="btn" href="https://ig.me/m/hubska.hair.lviv">Написати в Direct</a>
      </div>
      <ul class="c-shelves">
        <li><address>вул. Замарстинівська, 36</address></li>
        <li>пн–пт 10:00–19:00</li>
        <li>сб 10:00–17:00</li>
      </ul>
    </section>
  </div>
</Base>

<script>
  // Відео не входить у стартову вагу: вантажиться після першого кадру і лише коли рух дозволено
  const v = document.querySelector<HTMLVideoElement>('.c-video');
  const n = Number(new URLSearchParams(location.search).get('v'));
  if (v && n >= 2 && n <= 4) {
    v.poster = JSON.parse(v.dataset.posters!)[n - 1];
    v.querySelector('source')!.src = `/eskiz/c-${n}.mp4`;
    v.load();
  }
  if (v && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const go = () => { v.preload = 'auto'; v.play().catch(() => {}); };
    document.readyState === 'complete' ? go() : addEventListener('load', go, { once: true });
  }
</script>

<style>
  .c { position: relative; background: var(--color-marble); --px: clamp(20px, 3.9vw, 56px); --mw: min(27vw, 44svh); --gap: clamp(20px, 2.8vw, 44px); --h1: clamp(2.5rem, 6.8vw, 6.25rem); overflow: clip; }
  .c-rail { position: absolute; top: 0; bottom: 0; left: calc(var(--px) - 13px - 12px); }
  .c-hero { min-height: 100svh; box-sizing: border-box; padding: 92px var(--px) 36px; display: grid; grid-template-columns: 1fr var(--mw) 1fr; grid-template-rows: 1fr auto 1fr; column-gap: var(--gap); }
  .c-hero h1 { grid-column: 1 / -1; grid-row: 2; display: grid; grid-template-columns: 1fr var(--mw) 1fr; column-gap: var(--gap); font-size: var(--h1); line-height: 0.92; padding-bottom: 28px; }
  .c-hero h1 span:first-child { text-align: right; }
  .c-hero h1 span:last-child { grid-column: 3; }
  .c-mirror { grid-column: 2; grid-row: 1 / 4; align-self: center; aspect-ratio: 9 / 16; box-sizing: border-box; border: 3px solid #f4ead2; border-radius: 999px; padding: 7px; }
  .c-video { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 999px; background: var(--color-ink); }
  .c-act { grid-column: 1; grid-row: 3; justify-self: end; width: min(100%, var(--h1) * 4.3); /* ширина слова «Колористи»: абзац стоит под ним */ display: grid; gap: 22px; justify-items: start; align-content: start; font-size: var(--text-t2); }
  .c-shelves { grid-column: 3; grid-row: 3; align-self: start; margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; justify-items: start; font-size: var(--text-t3); color: var(--color-sand); }
  .c-shelves li { padding: 0 40px 7px 0; border-bottom: 2px solid var(--color-brass); }
  .c-shelves address { font-style: normal; }

  @media (max-width: 760px) {
    .c { --mw: min(52vw, 26svh * 2); }
    .c-rail { left: 4px; }
    .c-hero { min-height: 0; padding: 72px var(--px) 40px 34px; grid-template-columns: 1fr; grid-template-rows: none; row-gap: 16px; }
    .c-mirror { grid-column: 1; grid-row: 1; width: var(--mw); justify-self: center; }
    .c-hero h1 { grid-column: 1; grid-row: 2; display: block; padding: 4px 0 0; }
    .c-hero h1 span:first-child { text-align: left; display: block; }
    .c-act { grid-column: 1; grid-row: 3; justify-self: stretch; width: auto; gap: 16px; justify-items: stretch; font-size: var(--text-t3); }
    .c-shelves { grid-column: 1; grid-row: 4; }
  }
</style>
