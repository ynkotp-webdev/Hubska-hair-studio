---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, prices, nb, nw, url } from '../data/site';
import heroPoster from '../assets/photos/hero-1.jpg';
import r1 from '../assets/photos/robota-1.jpg';
import r2 from '../assets/photos/robota-2.jpg';
import r3 from '../assets/photos/robota-3.jpg';
import r4 from '../assets/photos/robota-4.jpg';
import r5 from '../assets/photos/robota-5.jpg';
import r6 from '../assets/photos/robota-6.jpg';
import do1 from '../assets/photos/do-1.jpg';
import pislia1 from '../assets/photos/pislia-1.jpg';
import do2 from '../assets/photos/do-2.jpg';
import pislia2 from '../assets/photos/pislia-2.jpg';
import do3 from '../assets/photos/do-3.jpg';
import pislia3 from '../assets/photos/pislia-3.jpg';
import olha from '../assets/photos/olha.jpg';
import cert from '../assets/photos/sertyfikaty.jpg';
import dohliad from '../assets/photos/dohliad.jpg';
import obraz from '../assets/photos/obraz.jpg';

// Видео первого экрана: догляд Braé в новом зале (выбор Остапа 24.11.2026: подходит под гамму)
const poster = (await getImage({ src: heroPoster, width: 720, format: 'webp' })).src;
const video = url('/video/hero-1');

// Техника в подписи взята из подписи поста
const works = [
  { img: r1, tech: 'AirTouch', alt: 'Довгий світлий блонд AirTouch із плавним переходом від кореня' },
  { img: r2, tech: 'Бразильський блонд', alt: 'Бразильський блонд із хвилями, вид зі спини' },
  { img: r3, tech: 'Однотонне фарбування', alt: 'Мідний відтінок до талії, вид зі спини' },
  { img: r4, tech: 'Рельєфне фарбування', alt: 'Прохолодно-бежевий блонд після рельєфного фарбування, довгі локони' },
  { img: r5, tech: 'Бразильський блонд', alt: 'Світлий бразильський блонд, пряме довге волосся, вид зі спини' },
  { img: r6, tech: 'Тонування', alt: 'Шоколадний відтінок після тонування, вид зі спини' },
];
const group = (id: string) => prices.find((g) => g.id === id)!;
const color = group('farbuvannia');
const care = group('dohliad');
const look = [...group('makiiazh').rows.filter(([n]) => /Денний|Вечірній|Весільний/.test(n)), ...group('zachisky').rows.filter(([n]) => /^Зачіска|Весільна/.test(n))];
---
<Base title="Hubska Hair Studio: колористи у Львові, AirTouch і блонд" description="Студія колористів на Замарстинівській, 36 у Львові: AirTouch, блонд, складні техніки, виправлення невдалих фарбувань. Ціни та запис у Direct." splash preloadImage={poster}>
  <div class="hero">
    <Header />
    <div class="hero-rail rail" aria-hidden="true"></div>
    <section class="hero-in">
      <h1><span>Колористи</span> <span>у&nbsp;Львові</span></h1>
      <div class="hero-mirror">
        <video class="hero-video" muted loop playsinline preload="none" poster={poster} data-src={video} aria-label="Довге волосся після догляду Braé в русі, зал Hubska Hair Studio">
          <source src={`${video}.mp4`} type="video/mp4" />
        </video>
      </div>
      <div class="hero-act">
        <p>AirTouch, блонд, складні техніки, виправлення невдалих фарбувань. Працюємо вдвох, щоб ви менше часу провели в кріслі.</p>
        <a class="btn" href={site.direct}>Написати в Direct</a>
      </div>
      <ul class="hero-shelves shelves">
        <li><address>{site.address}</address></li>
        <li>пн–пт 10:00–19:00</li>
        <li>сб 10:00–17:00</li>
      </ul>
    </section>
  </div>

  <main class="after">
    <section class="wk" id="roboty">
      <div class="wk-head">
        <h2>Роботи</h2>
        <a class="lnk more" href={site.instagram}>Більше робіт в Instagram</a>
      </div>
      <ul class="wk-strip" tabindex="0" aria-label="Роботи студії, гортається вбік">
        {works.map((w) => (
          <li>
            <figure>
              <Image src={w.img} alt={w.alt} widths={[300, 600]} sizes="(max-width: 760px) 62vw, 300px" loading="lazy" />
              <figcaption>{w.tech}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>

    <section class="ow" id="vlasnytsia" aria-labelledby="ow-name">
      <blockquote class="ow-quote">
        <p>Ми не обіцяємо неможливого і не ризикуємо волоссям заради бажаного відтінку.</p>
      </blockquote>
      <div class="ow-name">
        <h2 id="ow-name">Ольга Губська</h2>
        <p>Власниця студії, колористка</p>
      </div>
      <div class="ow-side">
        <Image src={olha} alt="Ольга Губська, власниця Hubska Hair Studio" widths={[420, 840]} sizes="(max-width: 760px) 100vw, 30vw" loading="lazy" />
        <p>Ольга працює в парі з колористкою Тетяною. Тетяна робить AirTouch, бразильський блонд, складні техніки, тонування та відновлення. У відгуках Google клієнтки називають обох на ім’я.</p>
        <blockquote class="q-text">
          <p>…майстри Оля та Таня справились на ура.</p>
          <cite>Julia Vanchytska, відгук у Google</cite>
        </blockquote>
      </div>
      <div class="ow-edu">
        <h3>Навчання</h3>
        <ul>
          <li>Семінар Іллі Новікова Total Blond &amp; AirTouch <span>2026</span></li>
          <li>RE:VISION, б’юті-подія <span>2026</span></li>
          <li>Семінари ProfLine <span>2025</span></li>
        </ul>
      </div>
      <div class="ow-cert">
        <Image src={cert} alt="Два сертифікати семінару Total blond & Air touch у руках" widths={[420, 840]} sizes="(max-width: 760px) 100vw, 30vw" loading="lazy" />
      </div>
    </section>

    <section class="ba" id="do-i-pislia">
      <h2 class="ba-head">До і після</h2>
      <div class="ba-grid">
        <figure class="ba-pair ba-p1">
          <div><Image src={do1} alt="До: жовтий блонд із відрослим коренем" widths={[360, 720]} sizes="(max-width: 760px) 50vw, 25vw" loading="lazy" /><span>До</span></div>
          <div><Image src={pislia1} alt="Після: холодний блонд у техніці AirTouch" widths={[360, 720]} sizes="(max-width: 760px) 50vw, 25vw" loading="lazy" /><span>Після</span></div>
        </figure>
        <div class="ba-note ba-n1">
          <h3>AirTouch</h3>
          <p set:html={nw('AirTouch класичний коштує 7 000–8 500 ₴ для довжини 1–3; остаточна вартість залежить від густоти та витрати матеріалу.')} />
          <a class="lnk more" href="#tsiny">Ціни на фарбування</a>
        </div>
        <figure class="ba-pair ba-p2">
          <div><Image src={do2} alt="До: відрослий AirTouch із рудим відтінком, вид зі спини" widths={[360, 720]} sizes="(max-width: 760px) 50vw, 25vw" loading="lazy" /><span>До</span></div>
          <div><Image src={pislia2} alt="Після: рівний світлий блонд, вид зі спини" widths={[360, 720]} sizes="(max-width: 760px) 50vw, 25vw" loading="lazy" /><span>Після</span></div>
        </figure>
        <div class="ba-note ba-n2">
          <h3>Виправлення попередньої роботи</h3>
          <p>У цьому випадку маємо відрослий AirTouch, небажаний рудий відтінок і недостатньо освітлений фон. Наша задача — вирівняти колір, прибрати небажану теплоту та створити плавний, чистий перехід до красивого блонду.</p>
        </div>
      </div>
      <div class="ba-case">
        <div class="ba-story">
          <h3>Коли ми відмовили у блонді</h3>
          <p>До нас дівчина прийшла з вираженим рудим відтінком після попередніх процедур та кератину. Хотіла красиву складну техніку з висвітленням. Але волосся було дуже тонким, а після кератину освітлення могло ще більше погіршити його стан… Ми чесно пояснили ситуацію та запропонували інше рішення — глибокий, насичений відтінок темного шоколаду, ближчий до натурального.</p>
          <a class="lnk more" href={site.direct}>Записатися на консультацію в Direct</a>
        </div>
        <figure class="ba-pair ba-p3">
          <div><Image src={do3} alt="До: рудий відтінок після попередніх процедур, колористка за спиною клієнтки" widths={[360, 720]} sizes="(max-width: 760px) 50vw, 29vw" loading="lazy" /><span>До</span></div>
          <div><Image src={pislia3} alt="Після: темний шоколад" widths={[360, 720]} sizes="(max-width: 760px) 50vw, 29vw" loading="lazy" /><span>Після</span></div>
        </figure>
      </div>
    </section>

    <section class="pr" id="tsiny">
      <div class="pr-rail rail" aria-hidden="true"></div>
      <div class="pr-side">
        <h2>Ціни на фарбування</h2>
        <p set:html={nw('Орієнтовна вартість для довжини 1–3 стандартної густини волосся. Остаточна залежить від густоти та витрати матеріалу.')} />
        <p>Свою довжину й точну суму уточніть у Direct.</p>
        <a class="lnk more" href={site.direct}>Написати в Direct</a>
        <a class="lnk more" href={url('/tsiny/')}>Повний прайс: стрижки, догляд, макіяж, зачіски</a>
      </div>
      <ul class="pr-wall">
        {color.rows.map(([name, price, note]) => (
          <li><span class="pr-name">{name}</span><span class="pr-val"><b>{price}</b>{note && <span set:html={nw(note)} />}</span></li>
        ))}
      </ul>
    </section>

    <section class="cr" id="dohliad">
      <figure class="cr-photo">
        <Image src={dohliad} alt="Гладке темне волосся після відновлення Braé і стрижки, вид зі спини" widths={[360, 720]} sizes="(max-width: 760px) 100vw, 20vw" loading="lazy" />
      </figure>
      <div class="cr-col">
        <h2>Догляд</h2>
        <dl>
          {care.rows.map(([name, price]) => <div><dt>{name.replace('Відновлення волосся ', 'Відновлення ')}</dt><dd>{price}</dd></div>)}
        </dl>
        <p class="cr-note" set:html={nw(`${care.note?.[0] ?? ''} Домашній догляд Olière Paris є в продажу в студії.`)} />
        <p class="cr-end">Особливо рекомендуємо LÉBEL для освітленого, фарбованого, сухого та пористого волосся.</p>
      </div>
      <div class="cr-col">
        <h2>Макіяж і зачіски</h2>
        <dl>
          {look.map(([name, price]) => <div><dt>{name}</dt><dd>{price}</dd></div>)}
        </dl>
        <p class="cr-note">{nb('Ранкові години до 10:00 коштують на 400 ₴ більше. Запис на макіяж і зачіски за попереднім завдатком 1 000 ₴.')}</p>
        <a class="lnk more cr-end" href={url('/tsiny/#makiiazh')}>Усі ціни на макіяж і зачіски</a>
      </div>
      <figure class="cr-photo">
        <Image src={obraz} alt="Макіяж і зачіска з локонами" widths={[360, 720]} sizes="(max-width: 760px) 100vw, 22vw" loading="lazy" />
      </figure>
    </section>

    <section class="ct" id="kontakty" aria-labelledby="ct-h">
      <div class="ct-rail rail" aria-hidden="true"></div>
      <h2 id="ct-h" class="sr-only">Контакти</h2>
      <address class="ct-addr">Львів, {site.address}</address>
      <div class="ct-cols">
        <div class="ct-book">
          <p>Запис у Direct або телефоном. Онлайн-запису немає.</p>
          <a class="btn" href={site.direct}>Написати в Direct</a>
          <a class="ct-tel" href={site.tel}>{site.phone}</a>
        </div>
        <div class="ct-info">
          <ul class="shelves">
            {site.hours.map(([d, h]) => <li><span>{d}</span><b>{h}</b></li>)}
          </ul>
          <ul class="ct-links">
            <li><a class="lnk more" href={site.maps}>Прокласти маршрут у Google Maps</a></li>
            <li><a class="lnk more" href={site.google}>{site.rating.value} ★ у Google, {site.rating.count} відгуків</a></li>
            <li><a class="lnk more" href={site.instagram}>Instagram @hubska.hair.lviv</a></li>
          </ul>
        </div>
      </div>
    </section>

    <Footer />

    <div class="bar">
      <a class="btn" href={site.direct}>Direct</a>
      <a class="bar-tel" href={site.tel}>Подзвонити</a>
    </div>
  </main>
</Base>

<script>
  // Видео не входит в стартовый вес: файл запрашивается после события load и только когда движение разрешено.
  // На телефоне берётся лёгкая версия 540p.
  const v = document.querySelector<HTMLVideoElement>('.hero-video');
  if (v && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const go = () => {
      v.querySelector('source')!.src = `${v.dataset.src}${matchMedia('(max-width: 760px)').matches ? '-m' : ''}.mp4`;
      v.preload = 'auto';
      v.load();
      v.play().catch(() => {});
    };
    document.readyState === 'complete' ? go() : addEventListener('load', go, { once: true });
  }

  // Роботи: мышью лента тянется за сам кадр. Пока тянут, привязка к кадрам выключена; после отпускания лента
  // доезжает до ближайшего кадра с поправкой на направление рывка. Палец и тачпад листают нативно.
  const strip = document.querySelector<HTMLElement>('.wk-strip');
  if (strip) {
    let x0 = 0, s0 = 0, on = false, target = 0, t = 0;
    const done = () => { if (!on) strip.classList.remove('drag'); };
    // запоздалый scrollend от самого перетаскивания не считается: ждём, пока лента дойдёт до кадра
    strip.addEventListener('scrollend', () => { if (Math.abs(strip.scrollLeft - target) < 2) done(); });
    strip.addEventListener('dragstart', (e) => e.preventDefault());
    strip.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      on = true; x0 = e.clientX; s0 = strip.scrollLeft; clearTimeout(t);
      strip.setPointerCapture(e.pointerId);
      strip.classList.add('drag');
    });
    strip.addEventListener('pointermove', (e) => { if (on) strip.scrollLeft = s0 - (e.clientX - x0); });
    const end = () => {
      if (!on) return;
      on = false;
      const items = [...strip.children] as HTMLElement[];
      const want = strip.scrollLeft + Math.sign(strip.scrollLeft - s0) * items[0].offsetWidth * 0.3;
      const stops = items.map((li) => li.offsetLeft - items[0].offsetLeft);
      target = Math.min(stops.reduce((a, b) => (Math.abs(b - want) < Math.abs(a - want) ? b : a)), strip.scrollWidth - strip.clientWidth);
      const smooth = matchMedia('(prefers-reduced-motion: no-preference)').matches;
      strip.scrollTo({ left: target, behavior: smooth ? 'smooth' : 'auto' });
      if (!smooth || Math.abs(target - strip.scrollLeft) < 2) return done();
      t = setTimeout(done, 1200); // запасной выход, если scrollend не придёт (старый Safari)
    };
    strip.addEventListener('pointerup', end);
    strip.addEventListener('pointercancel', end);
  }
</script>

<style>
  /* ---------- Первый экран: зеркало посреди фразы ---------- */
  .hero { position: relative; background: var(--color-marble); --mw: min(27vw, 44svh); --gap: clamp(20px, 2.8vw, 44px); overflow: clip; }
  .hero-rail { position: absolute; inset-block: 0; left: calc(var(--px) - 34px); }
  .hero-in { min-height: 100svh; box-sizing: border-box; padding: 92px var(--px) 36px; display: grid; grid-template-columns: 1fr var(--mw) 1fr; grid-template-rows: 1fr auto 1fr; column-gap: var(--gap); }
  .hero-in h1 { grid-column: 1 / -1; grid-row: 2; display: grid; grid-template-columns: 1fr var(--mw) 1fr; column-gap: var(--gap); font-size: var(--text-d1); line-height: 0.92; padding-bottom: 28px; }
  .hero-in h1 span:first-child { text-align: right; }
  .hero-in h1 span:last-child { grid-column: 3; }
  .hero-mirror { grid-column: 2; grid-row: 1 / 4; align-self: center; aspect-ratio: 9 / 16; box-sizing: border-box; border: 3px solid var(--color-led); border-radius: 999px; padding: 7px; }
  .hero-video { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 999px; background: var(--color-ink); }
  .hero-act { grid-column: 1; grid-row: 3; justify-self: end; width: min(100%, var(--text-d1) * 4.3); display: grid; gap: 22px; justify-items: start; align-content: start; }
  .hero-shelves { grid-column: 3; grid-row: 3; align-self: start; }

  /* ---------- Роботи: лента в край экрана ---------- */
  .wk { background: var(--color-ink); padding-block: var(--sec) calc(var(--sec) * 0.5); }
  .wk-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 40px; padding-inline: var(--px); }
  .wk-head h2 { font-size: var(--text-d2); line-height: 1; }
  /* лента тянется мышью за сам кадр (скрипт ниже), пальцем листается нативно; полосы прокрутки нет */
  .wk-strip { margin: 40px 0 0; padding: 0 var(--px); list-style: none; display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--px); scrollbar-width: none; cursor: grab; user-select: none; }
  .wk-strip::-webkit-scrollbar { display: none; }
  .wk-strip.drag { scroll-snap-type: none; cursor: grabbing; }
  .wk-strip li { flex: 0 0 clamp(220px, 21vw, 300px); scroll-snap-align: start; }
  .wk-strip figure, .ba-pair, .cr-photo { margin: 0; }
  .wk-strip :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 9 / 16; object-fit: cover; -webkit-user-drag: none; }
  .wk-strip figcaption { margin-top: 10px; font-size: var(--text-t4); color: var(--color-sand); }

  /* ---------- До і після: две пары во всю ширину, третий случай рядом с историей ---------- */
  .ba { background: var(--color-marble); padding-block: var(--sec); --pair-gap: clamp(16px, 2.4vw, 36px); }
  .ba-head { font-size: var(--text-d2); line-height: 1; padding-inline: var(--px); }
  .ba-grid { margin-top: 44px; display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--pair-gap); row-gap: 28px; }
  .ba-p1 { grid-area: 1 / 1; } .ba-n1 { grid-area: 2 / 1; padding-left: var(--px); }
  .ba-p2 { grid-area: 1 / 2; } .ba-n2 { grid-area: 2 / 2; padding-right: var(--px); }
  .ba-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .ba-pair div { position: relative; }
  .ba-pair :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; }
  .ba-pair span { position: absolute; left: 0; bottom: 0; padding: 4px 14px 5px; background: var(--color-marble); font-size: var(--text-t3); }
  .ba-note, .ba-story { display: grid; gap: 14px; align-content: start; justify-items: start; max-width: 36em; }
  .ba-note h3, .ba-story h3 { font-size: var(--text-d3); line-height: 1.08; }
  .ba .more { margin-top: -6px; }
  .ba-case { margin-top: clamp(48px, 6vw, 88px); display: grid; grid-template-columns: 5fr 7fr; column-gap: clamp(28px, 5vw, 80px); align-items: center; padding-left: var(--px); }

  /* ---------- Власниця: бежевая стена, блок ведёт цитата ---------- */
  .ow { background: var(--color-wall); color: var(--color-umber); padding: var(--sec) var(--px); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(16px, 2vw, 28px); row-gap: clamp(28px, 3.4vw, 48px); align-items: start; }
  .ow cite { color: var(--color-clay); }
  .ow-quote { grid-column: 1 / 9; grid-row: 1; }
  .ow-quote p { font-size: var(--text-d2); line-height: 1.04; }
  .ow-name { grid-column: 1 / 9; grid-row: 2; display: grid; gap: 4px; }
  .ow-name h2 { font-size: var(--text-d3); line-height: 1.08; }
  .ow-name p { color: var(--color-clay); }
  .ow-edu { grid-column: 1 / 5; grid-row: 3; display: grid; gap: 18px; align-content: start; }
  .ow-edu h3 { font-size: var(--text-d3); line-height: 1.08; }
  .ow-edu ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 14px; }
