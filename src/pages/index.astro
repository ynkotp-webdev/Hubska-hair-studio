---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, prices } from '../data/site';
import h1 from '../assets/photos/hero-1.jpg';
import h2 from '../assets/photos/hero-2.jpg';
import h3 from '../assets/photos/hero-3.jpg';
import h4 from '../assets/photos/hero-4.jpg';
import r1 from '../assets/photos/robota-1.jpg';
import r2 from '../assets/photos/robota-2.jpg';
import r3 from '../assets/photos/robota-3.jpg';
import r4 from '../assets/photos/robota-4.jpg';
import r5 from '../assets/photos/robota-5.jpg';
import r6 from '../assets/photos/robota-6.jpg';
import do1 from '../assets/photos/do-1.jpg';
import pislia1 from '../assets/photos/pislia-1.jpg';
import do2 from '../assets/photos/do-2.jpg';
import pislia2 from '../assets/photos/pislia-2.jpg';
import olha from '../assets/photos/olha.jpg';
import cert from '../assets/photos/sertyfikaty.jpg';
import obraz from '../assets/photos/obraz.jpg';

// Видео первого экрана: пока Остап выбирает, варианты переключаются через ?v=1…4
const posters = (await Promise.all([h1, h2, h3, h4].map((src) => getImage({ src, width: 720, format: 'webp' })))).map((p) => p.src);

const works = [
  { img: r1, tech: 'Корекція AirTouch', date: '18.11.2026', alt: 'Блонд після корекції AirTouch, вид зі спини' },
  { img: r2, tech: 'Однотонне фарбування', date: '01.11.2026', alt: 'Мідний відтінок до талії, вид зі спини' },
  { img: r3, tech: 'Фарбування', date: '28.10.2026', alt: 'Ягідно-винний відтінок, вид зі спини' },
  { img: r4, tech: 'Бразильський блонд', date: '12.11.2026', alt: 'Бразильський блонд із хвилями, вид зі спини' },
  { img: r5, tech: 'Фарбування й тонування', date: '22.10.2026', alt: 'Глибокий темний відтінок, вид зі спини' },
  { img: r6, tech: 'Тонування', date: '05.10.2026', alt: 'Шоколадний відтінок після тонування, вид зі спини' },
];
const group = (id: string) => prices.find((g) => g.id === id)!;
const care = group('dohliad');
const look = [...group('makiiazh').rows.filter(([n]) => /Денний|Вечірній|Весільний/.test(n)), ...group('zachisky').rows.filter(([n]) => /^Зачіска|Весільна/.test(n))];
---
<Base title="Hubska Hair Studio: колористи у Львові, AirTouch і блонд" description="Студія колористів на Замарстинівській, 36 у Львові: AirTouch, блонд, складні техніки, виправлення невдалих фарбувань. Ціни та запис у Direct." splash preloadImage={posters[0]}>
  <div class="hero">
    <Header />
    <div class="hero-rail rail" aria-hidden="true"></div>
    <section class="hero-in">
      <h1><span>Колористи</span> <span>у&nbsp;Львові</span></h1>
      <div class="hero-mirror">
        <video class="hero-video" muted loop playsinline preload="none" poster={posters[0]} data-posters={JSON.stringify(posters)} aria-label="Волосся після тонування та відновлення в русі, зал Hubska Hair Studio">
          <source src="/video/hero-1.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="hero-act">
        <p>AirTouch, блонд, складні техніки, виправлення невдалих фарбувань. Працюємо вдвох, щоб ви менше часу провели в кріслі.</p>
        <a class="btn" href={site.direct}>Написати в Direct</a>
      </div>
      <ul class="hero-shelves shelves">
        <li><address>{site.address}</address></li>
        <li>пн–пт 10:00–19:00</li>
        <li>сб 10:00–17:00</li>
      </ul>
    </section>
  </div>

  <main class="after">
    <section class="wk" id="roboty">
      <div class="wk-head">
        <h2>Роботи</h2>
        <div><p>Шість фарбувань за жовтень і листопад 2026, зняті зі спини в залі студії.</p><a class="lnk more" href={site.instagram}>Більше робіт в Instagram</a></div>
      </div>
      <ul class="wk-strip" tabindex="0" aria-label="Роботи студії, гортається вбік">
        {works.map((w) => (
          <li>
            <figure>
              <Image src={w.img} alt={w.alt} widths={[300, 600]} sizes="(max-width: 760px) 62vw, 300px" loading="lazy" />
              <figcaption>{w.tech} · {w.date}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>

    <section class="ba" id="do-i-pislia">
      <div class="ba-head">
        <h2>До і після</h2>
        <blockquote>
          <p>Не кожен бажаний відтінок із Pinterest можна точно відтворити на будь-якому волоссі.</p>
          <cite>Власниця студії, відповідь на відгук у Google</cite>
        </blockquote>
      </div>
      <div class="ba-grid">
        <figure class="ba-pair ba-p1">
          <div><Image src={do1} alt="До: жовтий блонд із відрослим коренем" widths={[360, 720]} sizes="(max-width: 760px) 50vw, 25vw" loading="lazy" /><span>До</span></div>
          <div><Image src={pislia1} alt="Після: холодний блонд у техніці AirTouch" widths={[360, 720]} sizes="(max-width: 760px) 50vw, 25vw" loading="lazy" /><span>Після</span></div>
        </figure>
        <div class="ba-note ba-n1">
          <h3>AirTouch</h3>
          <p>Робота від 12 листопада 2026. У прайсі AirTouch класичний коштує 7 000–8 500 ₴ для довжини 1–3; остаточна вартість залежить від густоти та витрати матеріалу.</p>
          <a class="lnk more" href="/tsiny/#farbuvannia">Ціни на фарбування</a>
        </div>
        <figure class="ba-pair ba-p2">
          <div><Image src={do2} alt="До: рудий відтінок після попередніх процедур, колористка за спиною клієнтки" widths={[360, 720]} sizes="(max-width: 760px) 50vw, 25vw" loading="lazy" /><span>До</span></div>
          <div><Image src={pislia2} alt="Після: темний шоколад" widths={[360, 720]} sizes="(max-width: 760px) 50vw, 25vw" loading="lazy" /><span>Після</span></div>
        </figure>
        <div class="ba-note ba-n2">
          <h3>Коли ми відмовили у блонді</h3>
          <blockquote class="q-text">
            <p>До нас дівчина прийшла з вираженим рудим відтінком після попередніх процедур та кератину. Хотіла красиву складну техніку з висвітленням. Але волосся було дуже тонким, а після кератину освітлення могло ще більше погіршити його стан… Ми чесно пояснили ситуацію та запропонували інше рішення — глибокий, насичений відтінок темного шоколаду, ближчий до натурального.</p>
            <cite>Допис студії в Instagram, 17 листопада 2026</cite>
          </blockquote>
        </div>
      </div>
    </section>

    <section class="ow" id="vlasnytsia">
      <div class="ow-photo">
        <Image src={olha} alt="Ольга Губська, власниця Hubska Hair Studio" widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 36vw" loading="lazy" />
      </div>
      <div class="ow-text">
        <h2>Ольга Губська</h2>
        <p class="ow-role">Власниця студії, колористка</p>
        <blockquote>
          <p>Ми не обіцяємо неможливого і не ризикуємо волоссям заради бажаного відтінку. Іноді краще обрати інший шлях, ніж отримати результат ціною пошкодженої довжини.</p>
          <cite>Допис студії з Ольгою в Instagram, 18 листопада 2026</cite>
        </blockquote>
        <p>Ольга працює в парі з колористкою Тетяною. Напрям Тетяни: AirTouch, бразильський блонд, складні техніки, тонування та відновлення. У відгуках Google клієнтки називають обох на ім’я.</p>
        <blockquote class="q-text">
          <p>…майстри Оля та Таня справились на ура.</p>
          <cite>Julia Vanchytska про AirTouch пудрою Braé, відгук у Google, 2 місяці тому станом на 21.11.2026</cite>
        </blockquote>
      </div>
      <div class="ow-edu">
        <h3>Навчання</h3>
        <ul>
          <li>Семінар Іллі Новікова Total Blond &amp; AirTouch <span>літо 2026, сертифікати</span></li>
          <li>RE:VISION, beauty-подія <span>липень 2026</span></li>
          <li>Семінари ProfLine <span>січень і вересень 2025</span></li>
        </ul>
        <Image src={cert} alt="Два сертифікати семінару Total blond & Air touch у руках" widths={[400, 800]} sizes="(max-width: 760px) 100vw, 26vw" loading="lazy" />
      </div>
    </section>

    <section class="pr" id="tsiny">
      <div class="pr-rail rail" aria-hidden="true"></div>
      <div class="pr-side">
        <h2>Ціни</h2>
        <p>Фарбування рахуємо за номером довжини волосся, від 1 до 4. Остаточна вартість залежить від густоти та витрати матеріалу.</p>
        <a class="lnk more" href="/tsiny/">Повний прайс</a>
      </div>
      <ul class="pr-wall">
        {prices.map((g) => (
          <li>
            <a href={`/tsiny/#${g.id}`}>{g.title}</a>
            <span><b>{g.from}</b> {g.cond}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="cr" id="dohliad">
      <div class="cr-col">
        <h2>Догляд</h2>
        <dl>
          {care.rows.map(([name, price]) => <div><dt>{name.replace('Відновлення волосся ', 'Відновлення ')}</dt><dd>{price}</dd></div>)}
        </dl>
        <p class="cr-note">{care.note?.[0]} Домашній догляд Olière Paris є в продажу в студії.</p>
        <blockquote class="q-text cr-end">
          <p>Особливо рекомендуємо LÉBEL для освітленого, фарбованого, сухого та пористого волосся, яке потребує якісного професійного догляду.</p>
          <cite>Допис студії в Instagram, 8 жовтня 2026</cite>
        </blockquote>
      </div>
      <div class="cr-photo">
        <Image src={obraz} alt="Макіяж і зачіска з локонами, робота студії" widths={[400, 800]} sizes="(max-width: 760px) 100vw, 28vw" loading="lazy" />
      </div>
      <div class="cr-col">
        <h2>Макіяж і зачіски</h2>
        <dl>
          {look.map(([name, price]) => <div><dt>{name}</dt><dd>{price}</dd></div>)}
        </dl>
        <p class="cr-note">Ранкові години до 10:00: +400 ₴. Запис на макіяж і зачіски за попереднім завдатком 1 000 ₴.</p>
        <a class="lnk more" href="/tsiny/#makiiazh">Усі ціни на макіяж і зачіски</a>
      </div>
    </section>

    <section class="ct" id="kontakty">
      <div class="ct-rail rail" aria-hidden="true"></div>
      <h2>Контакти</h2>
      <address class="ct-addr">Львів, {site.address}</address>
      <div class="ct-cols">
        <ul class="shelves">
          {site.hours.map(([d, h]) => <li>{d} <b>{h}</b></li>)}
        </ul>
        <div class="ct-book">
          <p>Запис у Direct або телефоном. Онлайн-запису немає.</p>
          <a class="btn" href={site.direct}>Написати в Direct</a>
          <a class="ct-tel" href={site.tel}>{site.phone}</a>
        </div>
        <ul class="ct-links">
          <li><a class="lnk" href={site.maps}>Прокласти маршрут у Google Maps</a></li>
          <li><a class="lnk" href={site.google}>{site.rating.value} ★ у Google, {site.rating.count} відгуків</a> <span>станом на {site.rating.date}</span></li>
          <li><a class="lnk" href={site.instagram}>Instagram @hubska.hair.lviv</a></li>
        </ul>
      </div>
    </section>

    <Footer />

    <div class="bar">
      <a class="btn" href={site.direct}>Direct</a>
      <a class="bar-tel" href={site.tel}>Подзвонити</a>
    </div>
  </main>
</Base>

<script>
  // Видео не входит в стартовый вес: файл запрашивается после события load и только когда движение разрешено.
  // На время выбора Остапом варианты переключаются через ?v=1…4; на телефоне берётся лёгкая версия 540p.
  const v = document.querySelector<HTMLVideoElement>('.hero-video');
  if (v) {
    const n = Number(new URLSearchParams(location.search).get('v'));
    const k = n >= 2 && n <= 4 ? n : 1;
    if (k > 1) v.poster = JSON.parse(v.dataset.posters!)[k - 1];
    if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      const go = () => {
        v.querySelector('source')!.src = `/video/hero-${k}${matchMedia('(max-width: 760px)').matches ? '-m' : ''}.mp4`;
        v.preload = 'auto';
        v.load();
        v.play().catch(() => {});
      };
      document.readyState === 'complete' ? go() : addEventListener('load', go, { once: true });
    }
  }
</script>

<style>
  /* ---------- Первый экран: зеркало посреди фразы ---------- */
  .hero { position: relative; background: var(--color-marble); --mw: min(27vw, 44svh); --gap: clamp(20px, 2.8vw, 44px); overflow: clip; }
  .hero-rail { position: absolute; inset-block: 0; left: calc(var(--px) - 25px); }
  .hero-in { min-height: 100svh; box-sizing: border-box; padding: 92px var(--px) 36px; display: grid; grid-template-columns: 1fr var(--mw) 1fr; grid-template-rows: 1fr auto 1fr; column-gap: var(--gap); }
  .hero-in h1 { grid-column: 1 / -1; grid-row: 2; display: grid; grid-template-columns: 1fr var(--mw) 1fr; column-gap: var(--gap); font-size: var(--text-d1); line-height: 0.92; padding-bottom: 28px; }
  .hero-in h1 span:first-child { text-align: right; }
  .hero-in h1 span:last-child { grid-column: 3; }
  .hero-mirror { grid-column: 2; grid-row: 1 / 4; align-self: center; aspect-ratio: 9 / 16; box-sizing: border-box; border: 3px solid var(--color-led); border-radius: 999px; padding: 7px; }
  .hero-video { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 999px; background: var(--color-ink); }
  .hero-act { grid-column: 1; grid-row: 3; justify-self: end; width: min(100%, var(--text-d1) * 4.3); display: grid; gap: 22px; justify-items: start; align-content: start; }
  .hero-shelves { grid-column: 3; grid-row: 3; align-self: start; }

  /* ---------- Роботи: лента в край экрана ---------- */
  .wk { background: var(--color-ink); padding-block: var(--sec) calc(var(--sec) - 24px); }
  .wk-head { display: grid; grid-template-columns: 1fr minmax(0, 26em); align-items: end; gap: 40px; padding-inline: var(--px); }
  .wk-head h2 { font-size: var(--text-d2); line-height: 1; }
  .wk-head p { color: var(--color-sand); }
  .wk-head div { display: grid; justify-items: start; }
  .wk-strip { margin: 40px 0 0; padding: 0 var(--px) 24px; list-style: none; display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--px); scrollbar-width: thin; }
  .wk-strip li { flex: 0 0 clamp(220px, 21vw, 300px); scroll-snap-align: start; }
  .wk-strip figure, .ba-pair { margin: 0; }
  .wk-strip :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 9 / 16; object-fit: cover; }
  .wk-strip figcaption { margin-top: 10px; font-size: var(--text-t4); color: var(--color-sand); }

  /* ---------- До і після: четыре кадра во всю ширину, истории под парами ---------- */
  .ba { background: var(--color-marble); padding-block: var(--sec); }
  .ba-head { display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--pair-gap); align-items: end; padding-inline: var(--px); --pair-gap: clamp(16px, 2.4vw, 36px); }
  .ba-head h2 { font-size: var(--text-d2); line-height: 1; }
  .ba-head blockquote { max-width: 30em; }
  .ba-grid { margin-top: 44px; display: grid; grid-template-columns: 1fr 1fr; column-gap: clamp(16px, 2.4vw, 36px); row-gap: 28px; }
  .ba-p1 { grid-area: 1 / 1; } .ba-n1 { grid-area: 2 / 1; padding-left: var(--px); }
  .ba-p2 { grid-area: 1 / 2; } .ba-n2 { grid-area: 2 / 2; padding-right: var(--px); }
  .ba-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .ba-pair div { position: relative; }
  .ba-pair :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; }
  .ba-pair span { position: absolute; left: 0; bottom: 0; padding: 4px 14px 5px; background: var(--color-marble); font-size: var(--text-t3); }
  .ba-note { display: grid; gap: 14px; align-content: start; justify-items: start; max-width: 36em; }
  .ba-note .more { margin-top: -10px; }
  .ba-note h3 { font-size: var(--text-d3); line-height: 1.08; }

  /* ---------- Власниця: бежевая стена, три колонки ---------- */
  .ow { background: var(--color-wall); color: var(--color-umber); display: grid; grid-template-columns: 36fr 34fr 30fr; gap: clamp(28px, 4vw, 64px); padding-right: var(--px); }
  .ow-photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 15%; }
  .ow-text, .ow-edu { padding-block: var(--sec); display: flex; flex-direction: column; gap: 22px; }
  .ow-text h2 { font-size: var(--text-d2); line-height: 1; }
  .ow-role { color: var(--color-clay); margin-top: -10px; }
  .ow-edu h3 { font-size: var(--text-d3); line-height: 1.08; }
  .ow-edu ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 14px; }
  .ow-edu li span { display: block; font-size: var(--text-t3); color: var(--color-clay); }
  .ow-edu :global(img) { display: block; width: 100%; height: auto; margin-top: auto; aspect-ratio: 5 / 4; object-fit: cover; }
  .ow cite { color: var(--color-clay); }

  /* ---------- Ціни: типографская стена, без линеек ---------- */
  .pr { position: relative; background: var(--color-ink); padding: var(--sec) var(--px) calc(var(--sec) * 1.5); display: grid; grid-template-columns: minmax(0, 20em) 1fr; gap: clamp(40px, 8vw, 128px); }
  .pr-rail { position: absolute; inset-block: 0; left: calc(var(--px) - 25px); }
  .pr-side { display: grid; gap: 14px; align-content: start; justify-items: start; }
  .pr-side h2 { font-size: var(--text-d2); line-height: 1; }
  .pr-side p { color: var(--color-sand); }
  .pr-wall { margin: 0; padding: 0; list-style: none; display: grid; gap: clamp(14px, 1.6vw, 22px); }
  .pr-wall li { display: grid; grid-template-columns: minmax(0, 5.2em) 1fr; align-items: baseline; column-gap: 28px; font-size: var(--text-d2); }
  .pr-wall a { font-family: var(--font-display); line-height: 1; text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .pr-wall a:hover { color: var(--color-gold); }
  .pr-wall span { font-size: var(--text-t2); line-height: 1.4; color: var(--color-sand); }
  .pr-wall b { font-weight: 600; color: var(--color-bone); white-space: nowrap; margin-right: 6px; }

  /* ---------- Догляд і образ: кадр посередине заходит на поле цен ---------- */
  .cr { background: var(--color-marble); display: grid; grid-template-columns: minmax(0, 1fr) min(28vw, 400px) minmax(0, 1fr); column-gap: clamp(28px, 4.5vw, 72px); padding: 0 var(--px) calc(var(--sec) * 0.75); }
  /* кадр тянется на высоту текстовых колонок и на полполя заходит вверх, на поле цен */
  .cr-photo { margin-top: calc(var(--sec) * -0.5); position: relative; z-index: 1; }
  .cr-photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 15%; }
  .cr-col { padding-top: var(--sec); display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .cr-col dl { align-self: stretch; }
  .cr-col h2 { font-size: var(--text-d2); line-height: 1; }
  .cr-col dl { margin: 0; display: grid; gap: 12px; }
  .cr-col dl div { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; }
  .cr-col dt { font-family: var(--font-display); font-size: var(--text-d4); line-height: 1.15; }
  .cr-col dd { margin: 0; white-space: nowrap; color: var(--color-sand); }
  .cr-note { font-size: var(--text-t3); color: var(--color-sand); }
  .cr-end, .cr-col .more { margin-top: auto; }

