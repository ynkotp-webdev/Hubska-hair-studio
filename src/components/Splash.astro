---
// Заставка: прядь из S рисуется, название печатается по букве, логотип целиком уходит в шапку.
// Один раз за сессию; без JS и при reduced-motion её нет. Геометрия повторяет логотип шапки в масштабе --k,
// поэтому посадка в шапку точная.
import Monogram from './Monogram.astro';
const lines = ['Hubska', 'Hair Studio'];
let n = 0;
---
<div class="splash" aria-hidden="true">
  <div class="splash-l">
    <span class="splash-m"><Monogram draw /></span>
    <span class="splash-w">
      {lines.map((line) => <span>{[...line].map((ch) => <i style={`--i:${n++}`}>{ch === ' ' ? ' ' : ch}</i>)}</span>)}
    </span>
  </div>
</div>
<script is:inline>
(function () {
  var root = document.documentElement;
  if (!root.classList.contains('intro')) return;
  var q = function (s) { return document.querySelector(s); };
  var box = q('.splash'), lock = q('.splash-l'), m = q('.splash-m'), w = q('.splash-w'), done = false, t;
  function end() { root.classList.remove('intro', 'intro-fly'); }
  function fly(fast) {
    if (done) return; done = true; clearTimeout(t);
    if (fast === true) box.style.transitionDuration = lock.style.transitionDuration = w.style.transitionDuration = '.22s';
    var to = q('[data-logo]'), word = q('.hd-word');
    if (to) {
      var a = m.getBoundingClientRect(), b = to.getBoundingClientRect(), l = lock.getBoundingClientRect();
      lock.style.transformOrigin = (a.left + a.width / 2 - l.left) + 'px ' + (a.top + a.height / 2 - l.top) + 'px';
      lock.style.transform = 'translate(' + (b.left + b.width / 2 - a.left - a.width / 2) + 'px,' + (b.top + b.height / 2 - a.top - a.height / 2) + 'px) scale(' + b.height / a.height + ')';
    }
    if (!word || !word.offsetParent) w.style.opacity = 0; // если названия в шапке нет, летит одна монограмма
    root.classList.add('intro-fly');
    setTimeout(end, fast === true ? 240 : 570);
  }
  t = setTimeout(fly, 2250);
  ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach(function (e) {
    addEventListener(e, function () { fly(true); }, { once: true, passive: true });
  });
})();
</script>
<style is:global>
  .splash { display: none; }
  .intro .splash { display: grid; place-items: center; position: fixed; inset: 0; z-index: 100; background: var(--color-ink); transition: background-color .55s ease; animation: splash-off 0s 3.6s forwards; }
  .intro .splash-l { --k: 3.2; display: flex; align-items: center; gap: calc(12px * var(--k)); transition: transform .55s cubic-bezier(.7, 0, .2, 1); }
  .intro .splash-m { display: block; height: calc(44px * var(--k)); color: var(--color-gold); }
  .intro .splash-m svg { display: block; height: 100%; width: auto; }
  .intro .splash-w { display: grid; font-size: calc(var(--text-t4) * var(--k)); font-weight: 600; letter-spacing: .16em; text-transform: uppercase; line-height: 1.25; white-space: nowrap; transition: opacity .3s ease; }
  .intro .splash-w i { font-style: normal; opacity: 0; animation: mk-type 0s calc(.95s + var(--i) * 55ms) forwards; }
  .intro .hd-logo > * { visibility: hidden; }
  .intro-fly .splash { background-color: transparent; pointer-events: none; }
  .mk { stroke-dasharray: 1; stroke-dashoffset: 1; animation: mk-draw .7s cubic-bezier(.5, 0, .2, 1) forwards; }
  .mk2 { animation-delay: .12s; }
  .mk3 { animation-delay: .22s; animation-duration: .8s; }
  .mk-h { opacity: 0; animation: mk-h .45s .6s ease-out forwards; }
  @keyframes mk-draw { to { stroke-dashoffset: 0; } }
  @keyframes mk-h { to { opacity: 1; } }
  @keyframes mk-type { to { opacity: 1; } }
  @keyframes splash-off { to { visibility: hidden; } }
  /* на телефоне логотип шапки мельче и плотнее: заставка повторяет его геометрию */
  @media (max-width: 760px) {
    .intro .splash-l { --k: 1.9; gap: calc(9px * var(--k)); }
    .intro .splash-m { height: calc(36px * var(--k)); }
    .intro .splash-w { letter-spacing: .12em; }
  }
</style>
