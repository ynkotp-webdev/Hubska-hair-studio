---
// Заставка: прядь из S рисуется, монограмма уходит в шапку. Один раз за сессию; без JS и при reduced-motion её нет.
import Monogram from './Monogram.astro';
---
<div class="splash" aria-hidden="true"><div class="splash-m"><Monogram draw /></div></div>
<script is:inline>
(function () {
  var root = document.documentElement;
  if (!root.classList.contains('intro')) return;
  var box = document.querySelector('.splash'), m = document.querySelector('.splash-m'), done = false, t;
  function end() { root.classList.remove('intro', 'intro-fly'); }
  function fly(fast) {
    if (done) return; done = true; clearTimeout(t);
    if (fast === true) box.style.transitionDuration = m.style.transitionDuration = '.22s';
    var to = document.querySelector('[data-logo]');
    if (to) {
      var a = m.getBoundingClientRect(), b = to.getBoundingClientRect();
      m.style.transform = 'translate(' + (b.left + b.width / 2 - a.left - a.width / 2) + 'px,' + (b.top + b.height / 2 - a.top - a.height / 2) + 'px) scale(' + b.height / a.height + ')';
    }
    root.classList.add('intro-fly');
    setTimeout(end, fast === true ? 240 : 520);
  }
  t = setTimeout(fly, 1150);
  ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach(function (e) {
    addEventListener(e, function () { fly(true); }, { once: true, passive: true });
  });
})();
</script>
<style is:global>
  .splash { display: none; }
  .intro .splash { display: grid; place-items: center; position: fixed; inset: 0; z-index: 100; background: var(--color-ink); color: var(--color-gold); transition: background-color .5s ease; animation: splash-off 0s 2.4s forwards; }
  .intro .splash-m { width: min(34vw, 150px); transition: transform .5s cubic-bezier(.7, 0, .2, 1); }
  .intro .splash-m svg { display: block; width: 100%; height: auto; }
  .intro [data-logo] { visibility: hidden; }
  .intro-fly .splash { background-color: transparent; pointer-events: none; }
  .mk { stroke-dasharray: 1; stroke-dashoffset: 1; animation: mk-draw .7s cubic-bezier(.5, 0, .2, 1) forwards; }
  .mk2 { animation-delay: .12s; }
  .mk3 { animation-delay: .22s; animation-duration: .8s; }
  .mk-h { opacity: 0; animation: mk-h .45s .6s ease-out forwards; }
  @keyframes mk-draw { to { stroke-dashoffset: 0; } }
  @keyframes mk-h { to { opacity: 1; } }
  @keyframes splash-off { to { visibility: hidden; } }
</style>
